  "schema": 2,
  "name": "ball-screw servo axis",
  "devices": [
    {
      "id": "screw", "kind": "servo_axis", "label": "Ball-screw axis", "mount": "floor",
      "pose": {"pos": [0, 0, 0], "rot": [0, 90, 0]},
      "params": {"stroke_mm": 300, "home_mm": 0, "home_at": "-x", "addr_grows": "away", "lead_mm": 10,
        "body_len_mm": 600, "body_w_mm": 220, "body_h_mm": 99, "carriage_len_mm": 140, "carriage_h_mm": 12},
      "basis": {"stroke_mm": "user", "lead_mm": "user", "body_len_mm": "guess", "body_w_mm": "guess", "body_h_mm": "guess", "carriage_len_mm": "guess", "carriage_h_mm": "guess", "pose": "guess"},
      "signals": [
        {"name": "servo_on", "dir": "out", "type": "bit"},
        {"name": "target", "dir": "out", "type": "word"},
        {"name": "busy", "dir": "in", "type": "bit"},
        {"name": "home_sw", "dir": "in", "type": "bit"},
        {"name": "ot_minus", "dir": "in", "type": "bit", "active": "low"},
        {"name": "ot_plus", "dir": "in", "type": "bit", "active": "low"}
      ],
      "mech": {
        "joints": [
          {"name": "carriage", "type": "form"},
          {"name": "motor", "type": "revolute", "on": "base", "pos": [-290, 80, 0], "axis": "-x", "wrap": true},
          {"name": "chain", "type": "prismatic", "on": "base", "pos": [90, 88.5, 129], "axis": "x", "min": 0, "max": 150}
        ],
        "couplings": [
          {"type": "ratio", "from": "carriage", "to": "motor", "lead_mm": 10},
          {"type": "ratio", "from": "carriage", "to": "chain", "k": 0.5}
        ],
        "drivers": [
          {"type": "follow", "joint": "carriage", "word": "target", "width": 16, "per_unit": 10, "speed": 250, "enable": "servo_on", "busy": "busy"}
        ],
        "sensors": [
          {"type": "window", "joint": "carriage", "at": 0, "window": 6, "out": "home_sw"},
          {"type": "window", "joint": "carriage", "at": -20, "window": 2, "out": "ot_minus"},
          {"type": "window", "joint": "carriage", "at": 320, "window": 2, "out": "ot_plus"}
        ],
        "basis": {"speed": "guess", "per_unit": "user", "lead_mm": "user", "k": "ref", "at": "guess", "window": "guess"}
      },
