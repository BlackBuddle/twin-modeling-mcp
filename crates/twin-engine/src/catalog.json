      },
      "behaviors": ["belt"],
      "io": {"run_fwd": {"dir": "out"}, "run_back": {"dir": "out"}},
      "params": {"speed_mm_s": {"type": "number", "min": 0, "max": 5000, "default": 100}}
    },
    "index_table": {
      "class": "electric", "label": "Index table (moves with mech; drawn only without it)", "form": "table", "simulated": false, "mech": true, "presets": ["index_table"],
      "behaviors": ["rotary"],
      "io": {"run": {"dir": "out"}, "home": {"dir": "in"}, "in_pos": {"dir": "in"}},
      "params": {"stations": {"type": "number", "min": 2, "max": 36, "default": 6}}
