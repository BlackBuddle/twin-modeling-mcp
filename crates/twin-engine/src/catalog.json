{
  "schema": 1,
  "signal_schema": {
    "name": "1 to 24 characters of A-Z a-z 0-9 _ -",
    "dir": "in | out (seen from the PLC: out = the PLC drives it, in = the PLC reads it)",
    "type": "bit | word | bcd",
    "device": "bit: X, Y or M address; word and bcd: D address",
    "active": "high | low (bit signals only, default high)"
  },
  "valve_types": ["5/2-double", "5/2-single", "3/2-single", "5/3-closed", "5/3-exhaust"],
  "params_note": "A param is {type:number, min, max, default}, {type:enum, values, default} or {type:bool, default}. timing:true kinds also take timing {lag_ms, fwd_ms, back_ms (0 to 60000), source}.",
  "presets_note": "A preset is a template of the device key `mech`: pick it with mech {preset, args, sensors?, basis?}. `args` are the preset's own values (arg_order is their order); a number field may be {arg, mul}. The server expands it to joints, couplings, drivers and sensors (facts.mech[].expanded). A preset gives the same motion as the same explicit mech.",
  "presets": {
    "servo_screw": {
      "kinds": ["servo_axis"],
      "label": "Ball-screw axis: the carriage follows a commanded position; the motor turns once for each lead_mm of travel",
      "signals": {"<word arg>": "word out (the commanded position)", "servo_on": "bit out (optional)", "busy": "bit in (optional, stand-in mode only)"},
      "arg_order": ["word", "width", "per_mm", "speed_mm_s", "enable", "busy"],
      "args": {
        "word": {"type": "signal", "use": "word"},
        "width": {"type": "enum", "values": [16, 32], "default": 16},
        "per_mm": {"type": "number", "min": 0.0001, "max": 100000, "default": 1},
        "speed_mm_s": {"type": "number", "min": 0.1, "max": 5000, "optional": true},
        "enable": {"type": "signal", "use": "bit_out", "default": "servo_on", "optional": true},
        "busy": {"type": "signal", "use": "bit_in", "default": "busy", "optional": true}
      },
      "mech": {
        "joints": [
          {"name": "carriage", "type": "form"},
          {"name": "motor", "type": "revolute", "on": "left", "pos": [0, 30, 0], "axis": "y", "wrap": true}
        ],
        "drivers": [{"type": "follow", "joint": "carriage", "word": {"arg": "word"}, "width": {"arg": "width"}, "per_unit": {"arg": "per_mm"},
                     "speed": {"arg": "speed_mm_s"}, "enable": {"arg": "enable"}, "busy": {"arg": "busy"}}],
        "couplings": [{"type": "ratio", "from": "carriage", "to": "motor", "lead_mm": {"param": "lead_mm"}}]
      }
    },
    "index_table": {
      "kinds": ["index_table"],
      "label": "Index table: each pulse on run turns one station (360 / stations) in move_ms after lag_ms",
      "signals": {"run": "io slot, bit out", "home": "io slot, bit in", "in_pos": "io slot, bit in (optional)"},
      "arg_order": ["move_ms", "lag_ms", "start_deg", "window_deg"],
      "args": {
        "move_ms": {"type": "number", "min": 1, "max": 60000, "default": 500},
        "lag_ms": {"type": "number", "min": 0, "max": 60000, "default": 50},
        "start_deg": {"type": "number", "min": 0, "max": 359.999, "default": 0},
        "window_deg": {"type": "number", "min": 0, "max": 45, "default": 1}
      },
      "mech": {
        "joints": [{"name": "table", "type": "revolute", "on": "top", "axis": "y", "wrap": true, "start": {"arg": "start_deg"}}],
        "drivers": [{"type": "step", "joint": "table", "pulse": "run", "count": {"param": "stations"}, "move_ms": {"arg": "move_ms"}, "lag_ms": {"arg": "lag_ms"}}],
        "sensors": [
          {"type": "window", "joint": "table", "at": 0, "window": {"arg": "window_deg"}, "out": "home"},
          {"type": "window", "joint": "table", "at": 0, "per_turn": {"param": "stations"}, "window": {"arg": "window_deg"}, "out": "in_pos", "optional": true}
        ]
      }
    },
    "robot_6r": {
      "kinds": ["robot_arm"],
      "label": "6-axis arm (generic figure of 10-architecture 12.5, no link offsets): plays a taught pose by a program number",
      "signals": {"start": "bit out", "prog": "word or bcd out", "busy": "bit in (optional)", "done": "bit in (optional)"},
      "arg_order": ["base_h_mm", "upper_mm", "fore_mm", "wrist_mm", "programs"],
      "args": {
        "base_h_mm": {"type": "number", "min": 0, "max": 3000, "default": 300},
        "upper_mm": {"type": "number", "min": 0, "max": 3000, "default": 400},
        "fore_mm": {"type": "number", "min": 0, "max": 3000, "default": 400},
        "wrist_mm": {"type": "number", "min": 0, "max": 3000, "default": 100},
        "programs": {"type": "programs"}
      },
      "mech": {
        "joints": [
          {"name": "j1", "type": "revolute", "on": "base", "axis": "y", "min": -180, "max": 180},
          {"name": "j2", "type": "revolute", "on": "j1", "pos": [0, {"arg": "base_h_mm"}, 0], "axis": "-z", "min": -180, "max": 180},
          {"name": "j3", "type": "revolute", "on": "j2", "pos": [0, {"arg": "upper_mm"}, 0], "axis": "-z", "min": -180, "max": 180},
          {"name": "j4", "type": "revolute", "on": "j3", "pos": [0, {"arg": "fore_mm"}, 0], "axis": "y", "min": -180, "max": 180},
          {"name": "j5", "type": "revolute", "on": "j4", "axis": "-z", "min": -180, "max": 180},
          {"name": "j6", "type": "revolute", "on": "j5", "pos": [0, {"arg": "wrist_mm"}, 0], "axis": "y", "min": -180, "max": 180},
          {"name": "flange", "type": "fixed", "on": "j6"}
        ],
        "drivers": [{"type": "playback", "joints": ["j1", "j2", "j3", "j4", "j5", "j6"], "select": "prog", "start": "start", "busy": "busy", "done": "done", "programs": {"arg": "programs"}}]
      }
    },
    "wheeled_base": {
      "kinds": ["machine"],
      "label": "Two-wheel base: the wheels turn by a program; the base follows by differential drive (no slip)",
      "signals": {"start": "bit out", "prog": "word or bcd out", "busy": "bit in (optional)", "done": "bit in (optional)"},
      "arg_order": ["wheel_d_mm", "track_mm", "programs"],
      "args": {
        "wheel_d_mm": {"type": "number", "min": 1, "max": 2000, "default": 100},
        "track_mm": {"type": "number", "min": 1, "max": 10000, "default": 300},
        "programs": {"type": "programs"}
      },
      "mech": {
        "joints": [
          {"name": "body", "type": "planar", "on": "base"},
          {"name": "wl", "type": "revolute", "on": "body", "pos": [0, {"arg": "wheel_d_mm", "mul": 0.5}, {"arg": "track_mm", "mul": -0.5}], "axis": "-z", "wrap": true},
          {"name": "wr", "type": "revolute", "on": "body", "pos": [0, {"arg": "wheel_d_mm", "mul": 0.5}, {"arg": "track_mm", "mul": 0.5}], "axis": "-z", "wrap": true}
        ],
        "couplings": [{"type": "diff_drive", "left": "wl", "right": "wr", "base": "body", "wheel_d_mm": {"arg": "wheel_d_mm"}, "track_mm": {"arg": "track_mm"}}],
        "drivers": [{"type": "playback", "joints": ["wl", "wr"], "select": "prog", "start": "start", "busy": "busy", "done": "done", "programs": {"arg": "programs"}}]
      }
    }
  },
  "kinds": {
    "cylinder_double": {
      "class": "pneumatic", "label": "Double-acting cylinder", "form": "cyl", "simulated": true,
      "params2": {
        "series": {"type": "enum", "values": ["generic", "smc_cm2"], "default": "generic"},
        "body_len_mm": {"type": "number", "min": 10, "max": 6000, "derive": true},
        "body_dia_mm": {"type": "number", "min": 4, "max": 600, "derive": true},
        "rod_dia_mm": {"type": "number", "min": 1, "max": 300, "derive": true},
        "rod_out_mm": {"type": "number", "min": 0, "max": 2000, "derive": true},
        "pivot_back_mm": {"type": "number", "min": 0, "max": 1000, "derive": true},
        "rod_end_mm": {"type": "number", "min": 0, "max": 500, "default": 0},
        "axis_h_mm": {"type": "number", "min": 0, "max": 1000, "derive": true}
      },
      "behaviors": ["valve", "linear"], "timing": true,
      "io": {"coil_fwd": {"dir": "out"}, "coil_back": {"dir": "out"}, "sensor_back": {"dir": "in"}, "sensor_fwd": {"dir": "in"}},
      "params": {
        "stroke_mm": {"type": "number", "min": 1, "max": 5000, "default": 100},
        "bore_mm": {"type": "number", "min": 1, "max": 500, "default": 20},
        "valve": {"type": "enum", "values": ["5/2-double", "5/2-single", "5/3-closed", "5/3-exhaust"], "default": "5/2-double"},
        "window_mm": {"type": "number", "min": 0, "max": 50, "default": 2},
        "on_delay_ms": {"type": "number", "min": 0, "max": 60000, "default": 0},
        "off_delay_ms": {"type": "number", "min": 0, "max": 60000, "default": 0}
      }
    },
    "cylinder_single": {
      "class": "pneumatic", "label": "Single-acting spring return cylinder", "form": "cyl", "simulated": true,
      "params2": {
        "series": {"type": "enum", "values": ["generic", "smc_cm2"], "default": "generic"},
        "body_len_mm": {"type": "number", "min": 10, "max": 6000, "derive": true},
        "body_dia_mm": {"type": "number", "min": 4, "max": 600, "derive": true},
        "rod_dia_mm": {"type": "number", "min": 1, "max": 300, "derive": true},
        "rod_out_mm": {"type": "number", "min": 0, "max": 2000, "derive": true},
        "pivot_back_mm": {"type": "number", "min": 0, "max": 1000, "derive": true},
        "rod_end_mm": {"type": "number", "min": 0, "max": 500, "default": 0},
        "axis_h_mm": {"type": "number", "min": 0, "max": 1000, "derive": true}
      },
      "behaviors": ["valve", "linear"], "timing": true,
      "io": {"coil_fwd": {"dir": "out"}, "sensor_back": {"dir": "in"}, "sensor_fwd": {"dir": "in"}},
      "params": {
        "stroke_mm": {"type": "number", "min": 1, "max": 5000, "default": 50},
        "bore_mm": {"type": "number", "min": 1, "max": 500, "default": 16},
        "valve": {"type": "enum", "values": ["5/2-single", "3/2-single"], "default": "5/2-single"},
        "window_mm": {"type": "number", "min": 0, "max": 50, "default": 2},
        "on_delay_ms": {"type": "number", "min": 0, "max": 60000, "default": 0},
        "off_delay_ms": {"type": "number", "min": 0, "max": 60000, "default": 0}
      }
    },
    "rotary_actuator": {
      "class": "pneumatic", "label": "Rotary actuator", "simulated": true,
      "behaviors": ["valve", "rotary"], "timing": true,
      "io": {"coil_fwd": {"dir": "out"}, "coil_back": {"dir": "out"}, "sensor_back": {"dir": "in"}, "sensor_fwd": {"dir": "in"}},
      "params": {
        "angle_deg": {"type": "number", "min": 1, "max": 360, "default": 90},
        "valve": {"type": "enum", "values": ["5/2-double", "5/2-single", "5/3-closed", "5/3-exhaust"], "default": "5/2-double"},
        "window_mm": {"type": "number", "min": 0, "max": 50, "default": 2},
        "on_delay_ms": {"type": "number", "min": 0, "max": 60000, "default": 0},
        "off_delay_ms": {"type": "number", "min": 0, "max": 60000, "default": 0}
      }
    },
    "gripper": {
      "class": "pneumatic", "label": "Pneumatic gripper (fwd = close)", "form": "jaw", "simulated": true,
      "behaviors": ["valve", "linear", "hold"], "timing": true,
      "io": {"coil_fwd": {"dir": "out"}, "coil_back": {"dir": "out"}, "sensor_back": {"dir": "in"}, "sensor_fwd": {"dir": "in"}},
      "params": {
        "reach_mm": {"type": "number", "min": 1, "max": 500, "default": 40},
        "stroke_mm": {"type": "number", "min": 1, "max": 500, "default": 20},
        "valve": {"type": "enum", "values": ["5/2-double", "5/2-single", "5/3-closed", "5/3-exhaust"], "default": "5/2-double"},
        "window_mm": {"type": "number", "min": 0, "max": 50, "default": 1},
        "on_delay_ms": {"type": "number", "min": 0, "max": 60000, "default": 0},
        "off_delay_ms": {"type": "number", "min": 0, "max": 60000, "default": 0}
      }
    },
    "vacuum_pad": {
      "class": "pneumatic", "label": "Vacuum pad", "simulated": true,
      "behaviors": ["light", "hold"],
      "io": {"coil": {"dir": "out"}},
      "params": {"reach_mm": {"type": "number", "min": 1, "max": 500, "default": 40}}
    },
    "part_source": {
      "class": "workpiece", "label": "Workpiece source (a part appears on the make bit or a click)", "simulated": true,
      "behaviors": ["source"],
      "io": {"make": {"dir": "in"}},
      "params": {"part_mm": {"type": "number", "min": 5, "max": 500, "default": 40}}
    },
    "part_sink": {
      "class": "workpiece", "label": "Workpiece sink (removes a part in its zone)", "simulated": true,
      "behaviors": ["sink"],
      "io": {},
      "params": {"zone_mm": {"type": "number", "min": 1, "max": 1000, "default": 60}}
    },
    "zone_sensor": {
      "class": "sensor", "label": "Presence sensor (ON while a workpiece is in its zone)", "simulated": true,
