      "io": {"output": {"dir": "in"}},
      "params": {"zone_mm": {"type": "number", "min": 1, "max": 1000, "default": 60}}
    },
    "motor": {
      "class": "electric", "label": "Motor (run forward / backward)", "simulated": true,
      "behaviors": ["rotary"],
      "io": {"run_fwd": {"dir": "out"}, "run_back": {"dir": "out"}},
      "params": {"speed_deg_s": {"type": "number", "min": 0, "max": 100000, "default": 360}}
    },
    "conveyor": {
      "class": "electric", "label": "Belt conveyor", "form": "belt", "simulated": true,
      "params2": {
