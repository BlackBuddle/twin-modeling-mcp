    "servo_axis": {
      "class": "electric", "label": "Servo axis (signals by the shared schema) (moves with mech; drawn only without it)", "form": "linear", "simulated": false, "mech": true, "presets": ["servo_screw"],
      "params2": {
        "home_at": {"type": "enum", "values": ["-x", "+x"], "default": "-x"},
        "addr_grows": {"type": "enum", "values": ["away", "toward"], "default": "away"},
        "home_mm": {"type": "number", "min": -100000, "max": 100000, "default": 0},
        "lead_mm": {"type": "number", "min": 0.01, "max": 1000, "optional": true},
        "carriage_len_mm": {"type": "number", "min": 10, "max": 2000, "default": 80},
        "carriage_h_mm": {"type": "number", "min": 1, "max": 500, "default": 20},
        "body_h_mm": {"type": "number", "min": 5, "max": 1000, "default": 60},
        "body_w_mm": {"type": "number", "min": 5, "max": 1000, "default": 80},
        "body_len_mm": {"type": "number", "min": 20, "max": 10000, "derive": true}
      },
      "behaviors": ["linear"], "signals": true,
      "io": {},
      "params": {"stroke_mm": {"type": "number", "min": 1, "max": 5000, "default": 200}}
